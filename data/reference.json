 "Rules": [
  {
   "RuleID": "DUP-001",
   "Category": "Duplicate",
   "RuleName": "Duplicate record ID",
   "AppliesTo": "Customer, Vendor, Material",
   "Severity": "Critical",
   "Enabled": true,
   "Threshold": null,
   "Description": "The same primary key appears on more than one row. Every occurrence after the first is flagged."
  },
  {
   "RuleID": "DUP-002",
   "Category": "Duplicate",
   "RuleName": "Exact duplicate record",
   "AppliesTo": "Customer, Vendor, Material",
   "Severity": "High",
   "Enabled": true,
   "Threshold": null,
   "Description": "Same normalised name and country (partners) or same normalised description, type and UoM (materials)."
  },
  {
   "RuleID": "DUP-003",
   "Category": "Duplicate",
   "RuleName": "Duplicate tax ID",
   "AppliesTo": "Customer, Vendor",
