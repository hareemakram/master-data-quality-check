   "Enabled": true,
   "Threshold": null,
   "Description": "Two records share the same tax / VAT registration number."
  },
  {
   "RuleID": "DUP-004",
   "Category": "Duplicate",
   "RuleName": "Duplicate email address",
   "AppliesTo": "Customer, Vendor",
   "Severity": "Medium",
   "Enabled": true,
   "Threshold": null,
   "Description": "Two records share the same email address."
  },
  {
   "RuleID": "DUP-005",
   "Category": "Duplicate",
